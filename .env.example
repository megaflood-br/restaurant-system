APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Com ngrok, use a URL HTTPS completa, ex.:
# APP_URL=https://seu-subdominio.ngrok-free.app

# Fuso horário do restaurante (afeta now(), cardápio aberto/fechado, agendamentos, imagem do dia)
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# SQLite: evita "database is locked" sob concorrência (ms / WAL).
DB_BUSY_TIMEOUT=10000
DB_JOURNAL_MODE=WAL
# Caminho do SQLite antigo ao migrar para MySQL (php artisan db:import-from-sqlite)
# SQLITE_LEGACY_PATH=/var/www/.../database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cardápio público em domínio próprio (ex.: bellabistro.com.br)
DIGITAL_MENU_PUBLIC_DOMAIN=


# Configurações do restaurante e impressão ficam em /settings (painel admin).

# API de integração n8n
INTEGRATION_API_TOKEN=
N8N_WEBHOOK_URL=
N8N_FORWARD_INBOUND=true
PHONE_DEFAULT_COUNTRY_CODE=55

# Evolution API (opcional — só se usar POST /api/v1/whatsapp/messages pelo sistema)
# Preferência: configurar em Configurações → Agente WhatsApp (salvos no banco).
# Estes valores do .env servem apenas como padrão inicial / fallback.
EVOLUTION_ENABLED=false
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_API_INSTANCE=restaurant
EVOLUTION_WEBHOOK_SECRET=

# OpenAI (agente WhatsApp inteligente)
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
